{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lmrbtp.local/schemas/scenario.schema.json",
  "title": "LLM Multi-Robot BT Planner Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "instruction",
    "initial_state",
    "goal_state",
    "entities",
    "resources",
    "robots"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"$ref": "#/$defs/identifier"},
    "instruction": {"type": "string", "minLength": 1},
    "initial_state": {"$ref": "#/$defs/predicateList"},
    "goal_state": {"$ref": "#/$defs/predicateList", "minItems": 1},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity"}
    },
    "resources": {
      "type": "array",
      "items": {"$ref": "#/$defs/resource"}
    },
    "robots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/robot"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
    "identifierList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "predicate": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*\\([^()]*\\)$"
    },
    "predicateList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/predicate"}
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["add", "delete"],
      "properties": {
        "add": {"$ref": "#/$defs/predicateList"},
        "delete": {"$ref": "#/$defs/predicateList"}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {
          "type": "string",
          "enum": ["part", "carrier", "location", "dock", "zone", "route", "fixture", "tool"]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capacity"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "capacity": {"const": 1}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parameters",
        "parameter_types",
        "resources",
        "action_type",
        "duration_ticks",
        "timeout_ticks",
        "preconditions",
        "effects"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "parameters": {"$ref": "#/$defs/identifierList"},
        "parameter_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["robot", "fixed_manipulator", "mobile_manipulator", "part", "carrier", "location", "dock", "zone", "route", "fixture", "tool"]
          }
        },
        "resources": {"$ref": "#/$defs/identifierList"},
        "action_type": {
          "type": "string",
          "enum": ["manipulation", "navigation", "docking", "verification", "task"]
        },
        "duration_ticks": {"type": "integer", "minimum": 1},
        "timeout_ticks": {"type": "integer", "minimum": 1},
        "preconditions": {"$ref": "#/$defs/predicateList"},
        "effects": {"$ref": "#/$defs/effects"}
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "name": {"type": "string", "minLength": 1},
        "type": {
          "type": "string",
          "enum": ["fixed_manipulator", "mobile_manipulator"]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/capability"}
        }
      }
    }
  }
}
