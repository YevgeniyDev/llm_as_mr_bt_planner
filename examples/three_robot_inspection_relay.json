{
  "schema_version": "1.0",
  "task_id": "three_robot_inspection_relay",
  "instruction": "Complete a three-robot inspection relay at inspection_station. Franka A must prepare the station first. The Unitree Go2 must travel from staging_dock to inspection_dock, wait for the station to be ready, use its Z1 arm to perform the inspection, stow the arm, and return to home_dock. Franka B must wait for the inspection result, certify it, and secure the station. Every operation at the station must respect the exclusive inspection_zone resource, and no robot may hold that resource while waiting for another robot.",
  "initial_state": [
    "system_ready()",
    "robot_ready(franka_a)",
    "robot_ready(unitree_go2_z1)",
    "robot_ready(franka_b)",
    "station_idle(inspection_station)",
    "base_stationary(unitree_go2_z1)",
    "arm_stowed(unitree_go2_z1)",
    "docked(unitree_go2_z1,staging_dock)"
  ],
  "goal_state": [
    "inspection_certified(inspection_station)",
    "station_safe(inspection_station)",
    "arm_stowed(unitree_go2_z1)",
    "docked(unitree_go2_z1,home_dock)"
  ],
  "entities": [
    {"id": "inspection_station", "type": "fixture"},
    {"id": "inspection_zone", "type": "zone"},
    {"id": "staging_dock", "type": "dock"},
    {"id": "inspection_dock", "type": "dock"},
    {"id": "home_dock", "type": "dock"}
  ],
  "resources": [
    {"id": "inspection_zone", "capacity": 1}
  ],
  "robots": [
    {
      "id": "franka_a",
      "name": "Franka Emika Panda A",
      "type": "fixed_manipulator",
      "capabilities": [
        {
          "name": "prepare_inspection_station",
          "parameters": ["station"],
          "parameter_types": ["fixture"],
          "resources": ["inspection_zone"],
          "action_type": "verification",
          "duration_ticks": 2,
          "timeout_ticks": 10,
          "preconditions": [
            "system_ready()",
            "robot_ready(franka_a)",
            "station_idle(station)"
          ],
          "effects": {
            "add": ["station_ready(station)"],
            "delete": ["station_idle(station)"]
          }
        }
      ]
    },
    {
      "id": "unitree_go2_z1",
      "name": "Unitree Go2 with Z1 arm",
      "type": "mobile_manipulator",
      "capabilities": [
        {
          "name": "navigate_between_docks",
          "parameters": ["origin", "destination"],
          "parameter_types": ["dock", "dock"],
          "resources": [],
          "action_type": "navigation",
          "duration_ticks": 4,
          "timeout_ticks": 20,
          "preconditions": [
            "system_ready()",
            "robot_ready(unitree_go2_z1)",
            "base_stationary(unitree_go2_z1)",
            "arm_stowed(unitree_go2_z1)",
            "docked(unitree_go2_z1,origin)"
          ],
          "effects": {
            "add": ["docked(unitree_go2_z1,destination)"],
            "delete": ["docked(unitree_go2_z1)"]
          }
        },
        {
          "name": "inspect_station_with_z1",
          "parameters": ["station"],
          "parameter_types": ["fixture"],
          "resources": ["inspection_zone"],
          "action_type": "verification",
          "duration_ticks": 3,
          "timeout_ticks": 15,
          "preconditions": [
            "system_ready()",
            "robot_ready(unitree_go2_z1)",
            "base_stationary(unitree_go2_z1)",
            "arm_stowed(unitree_go2_z1)",
            "docked(unitree_go2_z1,inspection_dock)",
            "station_ready(station)"
          ],
          "effects": {
            "add": [
              "inspection_complete(station)",
              "arm_deployed(unitree_go2_z1)"
            ],
            "delete": ["arm_stowed(unitree_go2_z1)"]
          }
        },
        {
          "name": "stow_z1_after_inspection",
          "parameters": ["station"],
          "parameter_types": ["fixture"],
          "resources": ["inspection_zone"],
          "action_type": "verification",
          "duration_ticks": 2,
          "timeout_ticks": 10,
          "preconditions": [
            "robot_ready(unitree_go2_z1)",
            "base_stationary(unitree_go2_z1)",
            "inspection_complete(station)",
            "arm_deployed(unitree_go2_z1)"
          ],
          "effects": {
            "add": ["arm_stowed(unitree_go2_z1)"],
            "delete": ["arm_deployed(unitree_go2_z1)"]
          }
        }
      ]
    },
    {
      "id": "franka_b",
      "name": "Franka Emika Panda B",
      "type": "fixed_manipulator",
      "capabilities": [
        {
          "name": "certify_inspection",
          "parameters": ["station"],
          "parameter_types": ["fixture"],
          "resources": ["inspection_zone"],
          "action_type": "verification",
          "duration_ticks": 2,
          "timeout_ticks": 10,
          "preconditions": [
            "system_ready()",
            "robot_ready(franka_b)",
            "inspection_complete(station)"
          ],
          "effects": {
            "add": ["inspection_certified(station)"],
            "delete": []
          }
        },
        {
          "name": "secure_inspection_station",
          "parameters": ["station"],
          "parameter_types": ["fixture"],
          "resources": ["inspection_zone"],
          "action_type": "verification",
          "duration_ticks": 2,
          "timeout_ticks": 10,
          "preconditions": [
            "system_ready()",
            "robot_ready(franka_b)",
            "inspection_certified(station)",
            "station_ready(station)"
          ],
          "effects": {
            "add": ["station_safe(station)"],
            "delete": ["station_ready(station)"]
          }
        }
      ]
    }
  ]
}
