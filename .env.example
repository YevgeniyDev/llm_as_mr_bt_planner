# Copy this file to .env and fill in the key for whichever provider you use.

# --- Anthropic (use with --provider anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Optional overrides:
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_TIMEOUT_SECONDS=120

# --- OpenAI (default provider) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Optional OpenAI-compatible endpoint overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
# OPENAI_TIMEOUT_SECONDS=180
# OPENAI_TEMPERATURE=0  # Applied only to models that support custom temperature; ignored for GPT-5.
